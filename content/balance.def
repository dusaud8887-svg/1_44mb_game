/* B3-융합: signal economy + combo resonance — the ON AIR combat<->deck loop (docs 60). */
BALANCE(PICKUP_LIFE_TICKS, 600)      /* a shard waits ~10s before it dissolves */
BALANCE(PICKUP_MAGNET_BASE, 16)      /* collect radius (px); NETWORK widens it */
