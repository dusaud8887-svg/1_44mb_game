/* B2-전투: deck tag-school thresholds for live ON AIR combat scaling (10_MECHANICS s4, 15_CARDS s9). */
BALANCE(COMBAT_TAG_TIER1, 2)
BALANCE(COMBAT_TAG_TIER2, 4)
BALANCE(COMBAT_TAG_TIER3, 6)
BALANCE(CARRIER_SPEED_PER_TIER, 6)
